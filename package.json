{
	"name": "@breakedge/the-board-mcp-server",
	"version": "0.2.1",
	"description": "Unofficial MCP server for board (the-board.jp) - cloud-based invoicing and project management SaaS",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"the-board",
		"invoice",
		"api",
		"typescript"
	],
	"license": "MIT",
	"author": "BREAKEDGE Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/breakedge/the-board-mcp-server.git"
	},
	"bin": {
		"the-board-mcp-server": "dist/index.js"
	},
	"files": [
		"dist/",
		"openapi/"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc && chmod +x dist/index.js",
		"prepare": "npm run build",
		"postinstall": "node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit",
		"release": "changeset publish"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.0",
		"yargs": "^17.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^2.31.0",
		"@types/node": "^20.0.0",
		"@types/yargs": "^17.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"msw": "^2.14.6",
		"tsx": "^4.22.4",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
